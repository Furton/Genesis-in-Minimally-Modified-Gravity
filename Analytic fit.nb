Cell[BoxData[
 RowBox[{RowBox[{"alphaGrid", "=", SuperscriptBox["10", RowBox[{"Subdivide", "[", RowBox[{RowBox[{"-", "30"}], ",", RowBox[{"-", "21"}], ",", "79"}], "]"}]]}], ";", RowBox[{"dGrid", "=", RowBox[{"Subdivide", "[", RowBox[{"0.1`", ",", "0.4`", ",", "79"}], "]"}]}], ";", RowBox[{"kappaGrid", "=", SuperscriptBox["10", RowBox[{"Subdivide", "[", RowBox[{RowBox[{"-", "9"}], ",", RowBox[{"-", "4"}], ",", "79"}], "]"}]]}], ";", RowBox[{RowBox[{"rowIndex", "[", RowBox[{"{", RowBox[{"a_", ",", "d_", ",", "k_"}], "}"}], "]"}], ":=", RowBox[{"1", "+", RowBox[{"6400", " ", RowBox[{"(", RowBox[{RowBox[{"First", "[", RowBox[{"Ordering", "[", RowBox[{RowBox[{"Abs", "[", RowBox[{"Log", "[", FractionBox["alphaGrid", "a"], "]"}], "]"}], ",", "1"}], "]"}], "]"}], "-", "1"}], ")"}]}], "+", RowBox[{"80", " ", RowBox[{"(", RowBox[{RowBox[{"First", "[", RowBox[{"Ordering", "[", RowBox[{RowBox[{"Abs", "[", RowBox[{"dGrid", "-", "d"}], "]"}], ",", "1"}], "]"}], "]"}], "-", "1"}], ")"}]}], "+", RowBox[{"(", RowBox[{RowBox[{"First", "[", RowBox[{"Ordering", "[", RowBox[{RowBox[{"Abs", "[", RowBox[{"Log", "[", FractionBox["kappaGrid", "k"], "]"}], "]"}], ",", "1"}], "]"}], "]"}], "-", "1"}], ")"}]}]}], ";", RowBox[{"samplePoints", "=", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"7.69265`*^-22", ",", "0.160759`", ",", "2.19671`*^-7"}], "}"}], ",", RowBox[{"{", RowBox[{"1.09138`*^-24", ",", "0.183544`", ",", "3.027`*^-6"}], "}"}], ",", RowBox[{"{", RowBox[{"4.55227`*^-22", ",", "0.251899`", ",", "5.91769`*^-8"}], "}"}], ",", RowBox[{"{", RowBox[{"2.26168`*^-25", ",", "0.164557`", ",", "6.2729`*^-6"}], "}"}]}], "}"}]}], ";"}]], "Input",
