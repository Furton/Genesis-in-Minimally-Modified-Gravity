 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"num", "[", "x_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"NumberQ", "[", "x", "]"}], ",", "x", ",", 
      RowBox[{"ToExpression", "@", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"x", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<e\>\"", "->", "\"\<*^\>\""}], ",", 
           RowBox[{"\"\<E\>\"", "->", "\"\<*^\>\""}]}], "}"}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"results", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Alpha]", "=", 
          RowBox[{"num", "@", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"col", "[", "\"\<alpha\>\"", "]"}], "]"}], "]"}]}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"d", "=", 
          RowBox[{"num", "@", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"col", "[", "\"\<d\>\"", "]"}], "]"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"\[Kappa]", "=", 
          RowBox[{"num", "@", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"col", "[", "\"\<kappa\>\"", "]"}], "]"}], "]"}]}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"psNum", "=", 
          FractionBox[
           RowBox[{"num", "@", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"col", "[", "\"\<Ps\>\"", "]"}], "]"}], "]"}]}], 
