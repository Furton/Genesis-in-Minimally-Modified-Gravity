         RowBox[{"psAna", "=", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"PsFormula", "[", 
             RowBox[{"\[Alpha]", ",", "d", ",", "\[Kappa]"}], "]"}], ",", 
